# ─────────────────────────────────────────────────────────────────────────────
# SAHAYAK — Environment Variables Reference
# Copy this file to .env.local for local development.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL.
# Local Docker: postgresql://sahayak:sahayak_local_dev@localhost:5432/sahayak
# Production:   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://sahayak:sahayak_local_dev@localhost:5432/sahayak

# ── Session Security ──────────────────────────────────────────────────────────
# 64-character random secret for signing session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED — application will not start without this.
SESSION_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING

# ── Application URL ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── Email (optional — leave blank to disable email notifications) ─────────────
# Local development: use Mailhog (docker compose includes it at port 1025).
# Web UI at http://localhost:8025 to view captured emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=your-smtp-username       # uncomment for authenticated SMTP
# SMTP_PASS=your-smtp-password       # uncomment for authenticated SMTP
SMTP_FROM=noreply@sahayak.local

# ── AI Features (optional) ────────────────────────────────────────────────────
# Leave blank to disable AI-assisted explanations.
# The application is fully functional without this key.
# When set, welfare explanations use the Gemini API.
# Only anonymized contributing factor names and scores are sent — never names,
# personnel IDs, unit locations, or confidential notes.
GEMINI_API_KEY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# DEMO_MODE=true enables the demo login banner and pre-seeded demo accounts.
# Set to "false" in production.
DEMO_MODE=true

# ENABLE_ML_FEATURES=true shows the experimental ML probability column.
# Requires the Python ML service to be running (see scripts/ml/README.md).
# Disabled by default — the rule engine is the authoritative assessment.
ENABLE_ML_FEATURES=false

# ML service URL (only used when ENABLE_ML_FEATURES=true)
# ML_SERVICE_URL=http://localhost:8080

# ── Privacy & Compliance ──────────────────────────────────────────────────────
# Minimum group size for commander aggregate views.
# Results with fewer personnel than this are suppressed with an explanation.
MIN_GROUP_SIZE=10

# Data retention in days (0 = retain indefinitely, which is the default for demo)
# CHECKIN_RETENTION_DAYS=365
# AUDIT_RETENTION_DAYS=730

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max login attempts per IP before lockout (15-minute window)
LOGIN_MAX_ATTEMPTS=5

# ── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
